{
  "name": "arena-monorepo",
  "private": true,
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  },
  "workspaces": [
    "packages/platform/*",
    "packages/games/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm --filter @arena/platform-server dev\" \"pnpm --filter @arena/platform-client dev\"",
    "dev:server": "pnpm --filter @arena/platform-server dev",
    "dev:client": "pnpm --filter @arena/platform-client dev",
    "build": "pnpm --filter @arena/platform-shared build && pnpm --filter @arena/platform-server build && pnpm --filter @arena/platform-client build",
    "build:server": "pnpm --filter @arena/platform-shared build && pnpm --filter @arena/platform-server build",
    "build:client": "pnpm --filter @arena/platform-shared build && pnpm --filter @arena/platform-client build",
    "start:server": "pnpm --filter @arena/platform-server start",
    "start:client": "pnpm --filter @arena/platform-client preview",
    "db:generate": "pnpm --filter @arena/platform-server db:generate",
    "db:migrate": "pnpm --filter @arena/platform-server db:migrate",
    "db:push": "pnpm --filter @arena/platform-server db:push",
    "db:studio": "pnpm --filter @arena/platform-server db:studio"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
