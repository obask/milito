{
  "name": "arena-monorepo",
  "private": true,
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "workspaces": [
    "packages/platform/*",
    "packages/games/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm dev:server\" \"pnpm --filter @app/client dev\"",
    "dev:server": "cd packages/server-python && ./venv/bin/uvicorn app.main:app --reload --port 4923",
    "dev:client": "pnpm --filter @app/client dev",
    "build": "pnpm --filter @app/shared build && pnpm --filter @app/client build",
    "build:client": "pnpm --filter @app/shared build && pnpm --filter @app/client build",
    "start:client": "pnpm --filter @app/client preview",
    "python:setup": "cd packages/server-python && python3 -m venv venv && ./venv/bin/pip install -r requirements.txt && ./venv/bin/python create_tables.py"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
